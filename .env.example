# Copy this file to .env and fill in the values before running docker compose.
# .env is gitignored — never commit it.
#
# For local development without Docker, see app/.env.example and server/.env.example.

# ── Frontend build ─────────────────────────────────────────────────────────
MAPBOX_API_KEY=pk.your_mapbox_public_token_here

# ── Backend: Authentication ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
AUTH_DISABLED=false

# ── Backend: CORS ──────────────────────────────────────────────────────────
# Space-separated list of allowed frontend origins
CORS_ORIGINS=http://your-server.example.com

# ── Backend: Scheduled snapshots (optional) ───────────────────────────────
# Runs once per day per user. Disable if not needed.
# SCHEDULED_MODEL_LOG_ENABLED=true
# SCHEDULED_MODEL_LOG_HOUR=12
# SCHEDULED_MODEL_LOG_MINUTE=0
# SCHEDULED_MODEL_LOG_TZ=America/Montreal
# SCHEDULED_MODEL_SNAPSHOT_LAT=45.55
# SCHEDULED_MODEL_SNAPSHOT_LNG=-73.55
# SCHEDULED_MODEL_ZONE_ID=default

# ── Backend: Twilio (SMS alerts, optional) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Backend: SendGrid (email alerts, optional) ────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=

# ── Backend: Gemini / report generation (optional) ────────────────────────
# Use "mock" for no network calls, "gemini" requires GEMINI_API_KEY
JOURNAL_REPORT_BACKEND=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
