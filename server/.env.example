# Auth: JWT secret
JWT_SECRET=change-me-in-production-use-env

# Admin account created on first run if no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Toggle authentication (default: true)
AUTH_DISABLED=true

# Optionnel : quand AUTH_DISABLED=true, utilisateur "dev" renvoyé par /api/auth/me (pour alertes)
# AUTH_STUB_EMAIL=dev@example.com
# AUTH_STUB_PHONE=+15145551234

# Optional: path to SQLite DB for users (default: server/app/auth.db)
# AUTH_DB_PATH=/path/to/auth.db

# --- Journalisation planifiée des modèles (1×/jour par utilisateur, même sans usage de l’app)
# Activé par défaut quand AUTH_DISABLED=false. Mettre à false pour désactiver.
# SCHEDULED_MODEL_LOG_ENABLED=true
# Heure locale (défaut : midi) — timezone IANA (ex. America/Montreal)
# SCHEDULED_MODEL_LOG_HOUR=12
# SCHEDULED_MODEL_LOG_MINUTE=0
# SCHEDULED_MODEL_LOG_TZ=America/Montreal
# Point géographique utilisé pour tous les snapshots (lat/lng + zone pluviale)
# SCHEDULED_MODEL_SNAPSHOT_LAT=45.55
# SCHEDULED_MODEL_SNAPSHOT_LNG=-73.55
# SCHEDULED_MODEL_ZONE_ID=default

# Optional: même jeton public Mapbox que l’app Angular — libellé quartier / ville (/api/place-label).
# Sans variable, le serveur utilise Nominatim (OpenStreetMap).
# MAPBOX_API_KEY=pk.your_mapbox_public_token_here

# Optional: CORS allowed origins, space-separated (default: http://localhost:4200)
# CORS_ORIGINS=https://your-frontend.example.com

# Twilio (alertes SMS) - optionnel; si absent, les SMS ne sont pas envoyés
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1234567890

# --- Rapports journal (Outlines + Gemini) — POST /api/admin/journal/reports/generate
# mock = pas d'appel réseau ; gemini = GEMINI_API_KEY requise
# JOURNAL_REPORT_BACKEND=mock
# JOURNAL_REPORT_BACKEND=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Secours automatique si ce modèle échoue : gemini-2.5-flash puis gemini-2.5-flash-lite (sans doublon)

# SendGrid (alertes email) - optionnel; si absent, les alertes email ne sont pas envoyées
# Créer une clé API sur https://app.sendgrid.com/settings/api_keys
# L'adresse ALERT_EMAIL_FROM doit être vérifiée dans SendGrid (Sender Authentication)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# ALERT_EMAIL_FROM=noreply@votredomaine.com
